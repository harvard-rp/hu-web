# Optional public HTTP(S) base URL for hu-api. Leave blank for standalone mode.
VITE_API_BASE_URL=
# Optional per-request timeout in milliseconds.
VITE_API_TIMEOUT_MS=5000

# Optional Supabase Auth origin and publishable key. Leave both blank for the public demo.
# Use HTTPS or an explicit local loopback origin. Never enter an OAuth secret or an admin key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
